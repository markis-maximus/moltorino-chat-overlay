{
  "provenance": {
    "repository": "https://github.com/EEVA-inc/Moltorino7",
    "commit": "2c98aaf8004842e7a25ff8aa07a362f9056c51b3",
    "rules": [
      "src/providers/twitch/TwitchBadge.cpp:46-64",
      "src/providers/moltorino/MoltorinoSupporterBadges.cpp:86-111,250-254,430-450,529-623,899-943",
      "src/messages/MessageBuilder.cpp:3418-3548,3628-3698",
      "src/messages/layouts/MessageLayoutElement.cpp:2181-2189"
    ],
    "note": "Expected values transcribed from the pinned native rules, not generated by the overlay. Synthetic inputs exercise branches absent from today's public registry."
  },
  "twitchGroups": {
    "ta": ["staff", "admin", "global_mod", "lead_moderator", "moderator", "vip", "broadcaster"],
    "ts": ["subscriber", "founder"],
    "tp": ["predictions"],
    "tv": ["bits", "premium", "partner", "turbo", "glhf-pledge", "predictions-extra", "future_badge"]
  },
  "layouts": [
    {
      "name": "missing user layout preserves message order",
      "preferences": {"badges": ["supporter"], "decorations": false},
      "expected": null
    },
    {
      "name": "explicit empty order uses native base and inserted provider slots",
      "preferences": {"order": []},
      "expected": {"order": ["ta", "ts", "tv", "tp", "c", "ff", "fa", "bt", "bl", "m", "7", "hc", "hs"], "hidden": []}
    },
    {
      "name": "trimmed partial order deduplicates and inserts Bluzyrino before Moltorino",
      "preferences": {"order": [" M ", "7", "m", 42, "unknown"], "hidden": [" TV ", "tv", "unknown", null]},
      "expected": {"order": ["bl", "m", "7", "ta", "ts", "tv", "tp", "c", "ff", "fa", "bt", "hc", "hs"], "hidden": ["tv"]}
    },
    {
      "name": "legacy Twitch keys move mentioned groups ahead of other providers",
      "preferences": {"order": ["7", "t:bits", "m", "t:subscriber", "t:vip", "tp", "ff"], "hidden": ["t:vip", "t:premium", "m"]},
      "expected": {"order": ["ta", "ts", "tv", "tp", "7", "bl", "m", "ff", "fa", "c", "bt", "hc", "hs"], "hidden": ["ta", "tv", "m"]}
    },
    {
      "name": "modern slots preserve their requested relative order",
      "preferences": {"order": ["7", "tv", "ts", "ta", "tp", "ff", "fa", "bl", "m"]},
      "expected": {"order": ["7", "tv", "ts", "ta", "tp", "ff", "fa", "bl", "m", "c", "bt", "hc", "hs"], "hidden": []}
    },
    {
      "name": "registry default is used when a layout exists without an order field",
      "defaultOrder": ["7", "m", "hc"],
      "preferences": {"activeBadge": null},
      "expected": {"order": ["7", "bl", "m", "hc", "ta", "ts", "tv", "tp", "c", "ff", "fa", "bt", "hs"], "hidden": []}
    },
    {
      "name": "non-array keys are ignored rather than iterated as strings",
      "defaultOrder": ["7", "m"],
      "preferences": {"order": "m", "hidden": "ta"},
      "expected": {"order": ["ta", "ts", "tv", "tp", "c", "ff", "fa", "bt", "bl", "m", "7", "hc", "hs"], "hidden": []}
    }
  ],
  "selections": [
    {"name": "first assignment wins despite higher later priority", "preferences": {"badges": ["founder", "supporter"]}, "expected": "founder"},
    {"name": "assignment order wins even with reversed definitions", "preferences": {"badges": ["supporter", "founder"]}, "expected": "supporter"},
    {"name": "explicit choice wins", "preferences": {"badges": ["founder", "supporter"], "activeBadge": "supporter"}, "expected": "supporter"},
    {"name": "null explicitly selects no badge", "preferences": {"badges": ["founder"], "activeBadge": null}, "expected": null},
    {"name": "empty string explicitly selects no badge", "preferences": {"badges": ["founder"], "activeBadge": " "}, "expected": null},
    {"name": "nonstring explicit choice selects no badge", "preferences": {"badges": ["founder"], "activeBadge": 123}, "expected": null},
    {"name": "unknown explicit choice falls back to first assignment", "preferences": {"badges": ["founder", "supporter"], "activeBadge": "retired"}, "expected": "founder"},
    {"name": "unassigned known choice falls back to first assignment", "preferences": {"badges": ["founder"], "activeBadge": "developer"}, "expected": "founder"},
    {"name": "assignment and preference IDs are normalized", "preferences": {"badges": [" FOUNDER ", " SUPPORTER "], "activeBadge": " SUPPORTER "}, "expected": "supporter"},
    {"name": "undefined assignments are skipped", "preferences": {"badges": ["retired", "founder", "founder"]}, "expected": "founder"},
    {"name": "unlisted developer badge is still displayable when assigned", "preferences": {"badges": ["developer"]}, "expected": "developer"},
    {"name": "no assignments cannot grant a badge", "preferences": {"badges": [], "activeBadge": "developer"}, "expected": null}
  ]
}
